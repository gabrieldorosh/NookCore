<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>net.nikosnook</groupId><artifactId>nookcore</artifactId><version>0.1.0-SNAPSHOT</version>
  <properties><maven.compiler.release>25</maven.compiler.release><project.build.sourceEncoding>UTF-8</project.build.sourceEncoding></properties>
  <repositories><repository><id>papermc</id><url>https://repo.papermc.io/repository/maven-public/</url></repository></repositories>
  <dependencies>
    <dependency><groupId>local.verified</groupId><artifactId>placeholderapi</artifactId><version>2.12.3</version><scope>system</scope><systemPath>${project.basedir}/../staging/candidates/PlaceholderAPI-2.12.3.jar</systemPath></dependency>
    <dependency><groupId>local.verified</groupId><artifactId>chestshop</artifactId><version>3.13-pre-1-474</version><scope>system</scope><systemPath>${project.basedir}/../staging/candidates/ChestShop.jar</systemPath></dependency>
    <dependency><groupId>local.verified</groupId><artifactId>worldguard</artifactId><version>7.0.19</version><scope>system</scope><systemPath>${project.basedir}/../staging/candidates/worldguard-bukkit-7.0.19.jar</systemPath></dependency>
    <dependency><groupId>local.verified</groupId><artifactId>worldedit</artifactId><version>7.4.5</version><scope>system</scope><systemPath>${project.basedir}/../staging/candidates/worldedit-bukkit-7.4.5.jar</systemPath></dependency>
    <dependency><groupId>local.verified</groupId><artifactId>vaultunlocked</artifactId><version>2.20.3</version><scope>system</scope><systemPath>${project.basedir}/../staging/candidates/VaultUnlocked-2.20.3.jar</systemPath></dependency>
    <dependency><groupId>io.papermc.paper</groupId><artifactId>paper-api</artifactId><version>26.2.build.126-stable</version><scope>provided</scope></dependency>
    <dependency><groupId>org.xerial</groupId><artifactId>sqlite-jdbc</artifactId><version>3.50.3.0</version></dependency>
    <dependency><groupId>org.junit.jupiter</groupId><artifactId>junit-jupiter</artifactId><version>5.13.4</version><scope>test</scope></dependency>
  </dependencies>
  <build><plugins>
    <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-compiler-plugin</artifactId><version>3.14.0</version></plugin>
